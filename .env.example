NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scan AI module
OPENAI_API_KEY=
# Recommended model for scan analysis
OPENAI_SCAN_MODEL=gpt-5.5

# Chat AI module
OPENAI_CHAT_MODEL=gpt-4o-mini

# Food Diary module — beta access allowlist (comma-separated e-mails).
# Absent or empty = feature blocked for everyone (fail closed). Normalized (trim + lowercase).
FOOD_DIARY_BETA_EMAILS=kaue.cunha@warren.com.br
# Food Diary AI model (reuses the project-wide OPENAI_API_KEY). Vision-capable; economical default.
OPENAI_FOOD_DIARY_MODEL=gpt-4o-mini
# Food Diary — max concluded analyses per student per local day (P1 default 6).
FOOD_DIARY_DAILY_ANALYSIS_LIMIT=6
